aobscanmodule(INJECT,ff7remake_.exe,41 0F 10 5F 10 0F 28 C2 48 8B 03 0F 28 CA 0F C6 C2 55 48 8B CB) // should be unique
alloc(newmem,$1000,INJECT)

label(code)
label(return)
alloc(pLoc,4)
registersymbol(pLoc)

pLoc:
dd (float)0



newmem:
cmp [rbx+50],05
jne code
mov [pLoc],r15
code:
  movups xmm3,[r15+10]
  jmp return

INJECT:
  jmp newmem
return:
registersymbol(INJECT)

[DISABLE]

unregistersymbol(pLoc)
dealloc(pLoc)
INJECT:
  db 41 0F 10 5F 10

unregistersymbol(INJECT)
dealloc(newmem)

