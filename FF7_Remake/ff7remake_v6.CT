alloc(newmem,$1000,INJECT)

label(code)
label(return)
alloc(nDam,4)
registersymbol(nDam)

nDam:
dd #9999



newmem:
cmp dword ptr [rsp+30],19 //= friendly so needs jne
//cmp dword ptr [RSP+28],ff7remake_.exe+94E094
//cmp [rcx+2c],#140
jne code
  mov rax,[rcx]
  call qword ptr [rax+50]
  jmp return
code:
  mov edx,[rcx+18]
  sub edx,[nDam]
  mov rax,[rcx]
  call qword ptr [rax+50]
  jmp return

INJECT:
  jmp newmem
  nop
return:
registersymbol(INJECT)

